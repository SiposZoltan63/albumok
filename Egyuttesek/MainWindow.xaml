<Window x:Class="Egyuttesek.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Egyuttesek"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Height="450px" Width="800px" OpacityMask="Black">
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="Red"/>
                <GradientStop Color="White" Offset="0.593"/>
                <GradientStop Color="White" Offset="0.4"/>
                <GradientStop Color="#FF41B531" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <DataGrid x:Name="datagridview" Height="400px" Width="500px" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="10,17,290,17"/>
        <Button x:Name="kilepesGomb" Content="Kilépés" HorizontalAlignment="Left" Margin="589,363,0,0" VerticalAlignment="Top" Width="142" Height="42" FontSize="24" Foreground="White" FontFamily="Segoe UI Black" Click="kilepesGomb_Click">
            <Button.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="Black"/>
                    <GradientStop Color="#FFFF2525" Offset="1"/>
                </LinearGradientBrush>
            </Button.Background>
        </Button>
        <Button x:Name="tszgomb" Content="Tagok száma" HorizontalAlignment="Left" Margin="589,0,0,0" VerticalAlignment="Center" Width="142" Height="38" Foreground="White" FontSize="20" FontFamily="Rockwell" Click="tszgomb_Click">
            <Button.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FF00FF56"/>
                    <GradientStop Color="Red" Offset="1"/>
                    <GradientStop Color="#FF04F308"/>
                </LinearGradientBrush>
            </Button.Background>
        </Button>
        <Button x:Name="lhagomb" Content="Leghosszabb album" HorizontalAlignment="Left" Margin="589,72,0,0" VerticalAlignment="Top" Width="142" Height="38" Background="#FF00D029" Foreground="White" FontFamily="Arial Black" FontWeight="Bold" Click="lhagomb_Click"/>

    </Grid>
</Window>
